# Required: Tavily, plus ONE way to reach Nemotron on Nebius Token Factory
TAVILY_API_KEY=your_tavily_key
NEBIUS_API_KEY=your_token_factory_key        # direct (preferred)
# OPENROUTER_API_KEY=sk-or-...               # or: via OpenRouter, pinned to the Nebius provider

# Optional: override model IDs if the Token Factory catalog changes
# MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MODEL_MID=nvidia/nemotron-3-super-120b-a12b
# MODEL_HEAVY=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: protect your credits
# RUNS_PER_HOUR=12
# RUN_PASSCODE=

# Optional: run with no API calls at all
# MOCK=1
